<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 and CounterStrikeSharp.API 1.0.374 are PanoramaManager's floor: the package targets net10.0 and
         declares that CSS version, so a lower pin fails restore with NU1605. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.374" />

    <!-- The kick card (src/ReservedSlots/Hud/KickHud.cs). Copied next to the plugin by CopyPanoramaManager below:
         each CounterStrikeSharp plugin loads from its own folder. Same version as our other HUD plugins. -->
    <PackageReference Include="PanoramaManager" Version="0.4.3" />

    <!-- Optional dependency, for the "X was kicked" toast (src/ReservedSlots/Hud/ToastBridge.cs). Compile-time
         only, and absent at runtime on a server without ToastService. The copy in lib/ is the same build as
         the one in addons/counterstrikesharp/shared/PanoramaManager.Toasts.Api/ on the servers.
         Private=false: the toast API must resolve from shared/ so this plugin and ToastService agree on the
         IToastApi type. A private copy next to the plugin gives it its own type and the capability cast
         fails as if ToastService were not installed. -->
    <Reference Include="PanoramaManager.Toasts.Api">
      <HintPath>lib\PanoramaManager.Toasts.Api.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- A class library does not copy package dlls on build, and turning CopyLocalLockFileAssemblies on would
       copy CounterStrikeSharp.API's whole tree. This copies PanoramaManager only. -->
  <Target Name="CopyPanoramaManager" AfterTargets="ResolveLockFileCopyLocalFiles">
    <ItemGroup>
      <ReferenceCopyLocalPaths Include="@(RuntimeCopyLocalItems)"
                               Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'PanoramaManager'" />
    </ItemGroup>
  </Target>

</Project>
